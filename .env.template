# Isabi Platform Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/isabi_db

# WhatsApp API Configuration
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
DEFAULT_RECIPIENT=default_recipient_phone_number

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Flutterwave Payment Configuration
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_CURRENCY=USD
FLUTTERWAVE_TIMEOUT=30

# Application Configuration
APP_BASE_URL=https://your-domain.com
DEBUG=False
PAYMENT_LINK_EXPIRY_MINUTES=5

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Google Cloud Configuration (for Vector DB)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/isabi_platform.log

# Security Configuration
SECRET_KEY=your_secret_key_for_jwt_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Monitoring Configuration (Optional)
SENTRY_DSN=your_sentry_dsn_for_error_tracking
PROMETHEUS_PORT=9090

# Development Configuration
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production Configuration (uncomment for production)
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-frontend-domain.com
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/key.pem
